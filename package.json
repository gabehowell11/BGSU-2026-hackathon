{
  "name": "ai-student-task-manager",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test:aivana": "node test-aivana.mjs",
    "seed": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/seed.js"
  },
  "dependencies": {
    "@aivana/sdk": "^0.7.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^8.21.2",
    "dotenv": "^17.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.3",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  }
}
